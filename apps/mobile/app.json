{
  "expo": {
    "name": "MatricMate",
    "slug": "matricmate",
    "version": "0.6.0",
    "scheme": "matricmate",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pk.matricmate.app"
    },
    "android": {
      "package": "pk.matricmate.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAFBF7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "MatricMate",
      "shortName": "MatricMate",
      "themeColor": "#096A8B",
      "backgroundColor": "#FAFBF7",
      "description": "Board exams, sorted. FBISE and Punjab Board Class 9 and 10 study, practice and AI tutor."
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FAFBF7"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0A7EA4"
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      "./plugins/with-okhttp-ping.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "df2c0bb2-55a1-4525-9874-b63fa6d0c876"
      }
    },
    "owner": "matricmate",
    "updates": {
      "url": "https://u.expo.dev/df2c0bb2-55a1-4525-9874-b63fa6d0c876"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
