# dependencies & build output
node_modules/
apps/mobile/dist/
apps/mobile/.expo/
apps/mobile/android/
apps/mobile/ios/
*.log

# secrets — never commit
contract/credentials.md
.env
.env.*
*.keystore
*.jks

# editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# scratch
tmp/

# agent/assistant config — local only, never committed
CLAUDE.md
AGENTS.md
.claude/
**/.claude/

# built APKs — large binaries, keep local only
builds/
image.png
*.apk
.next/
.vercel/
out/

# One lockfile, at the root. npm workspaces resolves every app from it, and a
# nested lockfile is worse than useless: it goes stale silently and describes a
# tree that cannot install, since @matricmate/core exists only in this repo.
apps/*/package-lock.json

# Knowledge graph for AI agents (local tooling, never a deliverable)
graphify-out/

# Session working notes for AI agents, never a deliverable
handoff.md
audit-result.md
audit-prompt.md

# Content drops from the client and the FBISE curriculum pull. Source
# material, often large PDFs, never a deliverable.
content/

# Screenshots dropped in the repo root while checking the app
image*.png

# The Firebase service account key. It can send push as us and read the
# project; it belongs in a password manager and in Vercel, never in git.
*-firebase-adminsdk-*.json

# NOT ignored, deliberately: apps/mobile/google-services.json. It holds the
# project id, the app id and the Android API key, all of which ship inside
# every APK and are restricted to our package name, so there is nothing in it
# to leak. Ignoring it broke the build instead: EAS decides what to archive
# from this file, so the Android build reached Gradle with no FCM config.
