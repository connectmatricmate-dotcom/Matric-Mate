{
  "name": "matricmate",
  "private": true,
  "version": "0.1.0",
  "description": "MatricMate \u00b7 FBISE Class 9 exam prep. Android app, web app and shared domain code.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace apps/mobile",
    "web": "npm run dev --workspace apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspace apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "node scripts/check.mjs",
    "content:fetch": "node scripts/fetch-fbise.mjs",
    "content:toppers": "node scripts/fetch-toppers.mjs",
    "content:papers": "node scripts/build-papers-catalogue.mjs",
    "content:host-papers": "node scripts/host-zip-papers.mjs",
    "content:build": "node scripts/build-curriculum.mjs",
    "content:ingest": "node scripts/ingest-content.mjs",
    "content:verify": "node scripts/verify-content.mjs",
    "content:audit": "node scripts/audit-content.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "mobile:go": "npm run start --workspace apps/mobile -- --go",
    "mobile:tunnel": "npm run start --workspace apps/mobile -- --go --tunnel",
    "android:log": "bash scripts/android-crashlog.sh",
    "apk": "node scripts/build-apk.mjs",
    "grant": "node scripts/grant-plan.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "react-native-worklets": "0.10.1",
    "react-native-reanimated": "4.5.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "pg": "^8.23.0"
  }
}
